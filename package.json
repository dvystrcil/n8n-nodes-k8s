{
  "name": "@dvystrcil/n8n-nodes-k8s",
  "version": "0.3.0",
  "private": true,
  "description": "n8n node for starting and polling Kubernetes Jobs built from suspended CronJob templates",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "author": {
    "name": "HuPo (original), dvystrcil (fork)"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dvystrcil/n8n-nodes-k8s.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec test/",
    "test:unit": "node --test test/",
    "mutate": "stryker run",
    "audit:deps": "node scripts/audit-deps.mjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KubernetesTokenApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/KubernetesBatch/KubernetesBatch.node.js"
    ]
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "26.6.6",
    "n8n-workflow": "2.45.4",
    "typescript": "7.0.2"
  }
}
