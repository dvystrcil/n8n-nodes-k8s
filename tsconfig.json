{
	"compilerOptions": {
		"strict": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"lib": ["es2023"],
		"types": ["node"],
		"removeComments": false,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"declaration": false,
		"sourceMap": false,
		"skipLibCheck": true,
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"include": ["src/**/*.ts"]
}
